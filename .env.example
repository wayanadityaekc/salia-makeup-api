# Postgres connection string (Railway provides this).
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Secret used to sign owner JWTs. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# The single owner/dashboard password.
ADMIN_PASSWORD=change-me

# Frontend origin(s) allowed by CORS. Comma-separated for more than one.
CORS_ORIGIN=https://saliamakeup.com,https://www.saliamakeup.com

# Set true to also allow any https://*.vercel.app origin (handy while testing on
# Vercel preview/production URLs). Turn off once the real domain is pointed.
# ALLOW_VERCEL_PREVIEWS=true

# Port to listen on (Railway sets this automatically).
PORT=4000

# Set to "off" only for a local Postgres without SSL.
# PGSSL=off
